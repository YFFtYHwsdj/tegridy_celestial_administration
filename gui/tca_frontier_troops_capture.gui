# 北疆军队现场快照；只在CLI就绪、debug用例显式请求时运行。
# 保存真实战争和军队，不修改军团归属或兵力；存档成功仍须核对原生日志与文件。
widget = {
    name = "tca_frontier_troops_capture"
    size = { 1 1 }
    alwaystransparent = yes
    alpha = 0
    visible_at_creation = no
    datacontext = "[GetTitleByKey('h_china')]"
    visible = "[And(InDebugMode, And(IsInGame, And(GreaterThan_CFixedPoint(Title.MakeScope.Var('tca_cli_ready').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Title.MakeScope.Var('tca_frontier_troops_capture_phase').GetValue, '(CFixedPoint)1'))))]"
    state = {
        name = _show
        on_start = "[SetGameSpeed('(int32)0')]"
        duration = 1
        next = "tca_frontier_troops_save"
    }
    state = {
        name = "tca_frontier_troops_save"
        on_start = "[ExecuteConsoleCommand('save tca_frontier_troops_probe')]"
        duration = 8
        next = "tca_frontier_troops_resume"
    }
    state = {
        name = "tca_frontier_troops_resume"
        on_start = "[SetGameSpeed('(int32)4')]"
    }
}
