# 测试进度窗口；读取 h_china 上的状态快照，报告者死亡后仍可查看最终结果。
# 运行阶段禁止关闭；完成后关闭只隐藏快照，统计数据由正式状态效果维护。
window = {
    name = "tca_test_status_window"
    parentanchor = top|right
    position = { -30 140 }
    size = { 400 290 }
    layer = windows_layer
    movable = yes
    filter_mouse = all
    allow_outside = yes
    alwaystransparent = no
    using = Window_Background
    using = Window_Decoration
    datacontext = "[GetTitleByKey('h_china')]"
    visible = "[And( IsInGame, GreaterThan_CFixedPoint(Title.MakeScope.Var('tca_test_status_visible').GetValue, '(CFixedPoint)0') )]"

    vbox = {
        using = Window_Margins
        spacing = 10
        header_pattern = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_text" { text = "tca_test_status_title" }
            blockoverride "button_close" {
                enabled = "[Not(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)1'))]"
                onclick = "[ExecuteConsoleCommand('effect title:h_china = { tca_test_close_status_effect = yes }')]"
            }
        }
        text_single = {
            text = "tca_test_status_running"
            visible = "[EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)1')]"
        }
        text_single = {
            text = "tca_test_status_passed"
            visible = "[EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)2')]"
        }
        text_single = {
            text = "tca_test_status_failed"
            visible = "[EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)3')]"
        }
        text_multi = {
            max_width = 350
            text = "tca_test_status_aborted_death"
            visible = "[And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)4'), EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_reason').GetValue, '(CFixedPoint)1'))]"
        }
        text_multi = {
            max_width = 350
            text = "tca_test_status_aborted_environment"
            visible = "[And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)4'), Not(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_reason').GetValue, '(CFixedPoint)1')))]"
        }
        text_single = { text = "tca_test_status_progress" }
        text_single = { text = "tca_test_status_counts" }
        text_multi = {
            max_width = 350
            text = "tca_test_status_waiting"
            visible = "[EqualTo_CFixedPoint(Title.MakeScope.Var('tca_test_status_phase').GetValue, '(CFixedPoint)1')]"
        }
    }
}
