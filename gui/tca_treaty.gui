# 独立条款窗口；正式和约仅由核心接受／结算入口修改。
window = {
 name = "tca_treaty_window"
 parentanchor = center
 size = { 660 780 }
 layer = windows_layer
 movable = yes
 filter_mouse = all
 using = Window_Background
 using = Window_Decoration
 visible = "[And(IsInGame, GetPlayer.MakeScope.Var('tca_treaty_gui_open').IsSet)]"
 vbox = {
  using = Window_Margins
  spacing = 12
  header_pattern = {
   blockoverride "header_text" { text = "tca_treaty_gui_title" }
   blockoverride "button_close" { onclick = "[GetScriptedGui('tca_treaty_gui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]" }
  }
  scrollarea = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   scrollbarpolicy_horizontal = always_off
   scrollbar_vertical = { using = Scrollbar_Vertical }
   scrollwidget = { vbox = {
    layoutpolicy_horizontal = expanding
    spacing = 12
  text_single = { text = "tca_treaty_gui_target" }
  text_multi = { text = "tca_treaty_gui_terms" max_width = 590 }
  vbox = {
   visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_existing').IsSet]"
   datacontext = "[GetPlayer.MakeScope.Var('tca_treaty_gui_existing')]"
   text_multi = { text = "tca_treaty_gui_current" max_width = 590 }
   text_single = { text = "tca_treaty_gui_payer" visible = "[Scope.Var('tca_treaty_payer').IsSet]" }
   text_single = { text = "tca_treaty_gui_arrears" visible = "[GreaterThan_CFixedPoint(Scope.Var('tca_treaty_arrears').GetValue, '(CFixedPoint)0')]" }
  }
  text_single = { text = "tca_treaty_gui_readonly" visible = "[Not(GetScriptedGui('tca_treaty_gui_edit').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End))]" }
  vbox = {
   visible = "[GetScriptedGui('tca_treaty_gui_debt_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
   spacing = 6
   hbox = { spacing = 8
button_standard = { size = { 175 40 } text = "tca_treaty_gui_pay"
    enabled = "[GetScriptedGui('tca_treaty_gui_pay').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_pay').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
}
button_standard = { size = { 195 40 } text = "tca_treaty_gui_refuse_arm"
    enabled = "[GetScriptedGui('tca_treaty_gui_refuse_arm').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_refuse_arm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
}
   }
button_standard = { size = { 250 40 } text = "tca_treaty_gui_refuse"
    enabled = "[GetScriptedGui('tca_treaty_gui_refuse').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_refuse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_refuse_confirm').IsSet]"
}
   text_multi = { text = "tca_treaty_gui_refuse_warning" max_width = 590 visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_refuse_confirm').IsSet]" }
  }
  divider = { layoutpolicy_horizontal = expanding }
  text_single = { text = "tca_treaty_gui_amount_heading" }
  hbox = { spacing = 5
button_standard = { size = { 78 40 } raw_text = "0"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_0').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)0')]"
}
button_standard = { size = { 78 40 } raw_text = "100"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_100').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_100').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)100')]"
}
button_standard = { size = { 78 40 } raw_text = "250"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_250').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_250').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)250')]"
}
button_standard = { size = { 78 40 } raw_text = "500"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_500').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_500').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)500')]"
}
button_standard = { size = { 78 40 } raw_text = "1000"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_1000').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_1000').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)1000')]"
}
button_standard = { size = { 78 40 } raw_text = "2000"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_2000').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_2000').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)2000')]"
}
button_standard = { size = { 78 40 } raw_text = "5000"
    enabled = "[GetScriptedGui('tca_treaty_gui_amount_5000').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_amount_5000').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_amount').GetValue, '(CFixedPoint)5000')]"
}
  }
  hbox = { spacing = 8
button_standard = { size = { 185 40 } text = "tca_treaty_gui_direction_0"
    enabled = "[GetScriptedGui('tca_treaty_gui_direction_0').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_direction_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_direction').GetValue, '(CFixedPoint)0')]"
}
button_standard = { size = { 185 40 } text = "tca_treaty_gui_direction_1"
    enabled = "[GetScriptedGui('tca_treaty_gui_direction_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_direction_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_direction').GetValue, '(CFixedPoint)1')]"
}
button_standard = { size = { 185 40 } text = "tca_treaty_gui_direction_2"
    enabled = "[GetScriptedGui('tca_treaty_gui_direction_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_direction_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_direction').GetValue, '(CFixedPoint)2')]"
}
  }
  text_single = { text = "tca_treaty_gui_proposal_heading" }
  hbox = { spacing = 8
button_standard = { size = { 185 40 } text = "tca_treaty_gui_mode_0"
    enabled = "[GetScriptedGui('tca_treaty_gui_mode_0').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_mode_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_mode').GetValue, '(CFixedPoint)0')]"
}
button_standard = { size = { 185 40 } text = "tca_treaty_gui_mode_1"
    enabled = "[GetScriptedGui('tca_treaty_gui_mode_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_mode_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_mode').GetValue, '(CFixedPoint)1')]"
}
button_standard = { size = { 185 40 } text = "tca_treaty_gui_mode_2"
    enabled = "[GetScriptedGui('tca_treaty_gui_mode_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_mode_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('tca_treaty_gui_mode').GetValue, '(CFixedPoint)2')]"
}
  }
  text_multi = { text = "tca_treaty_gui_pending" max_width = 590 }
button_standard = { size = { 240 40 } text = "tca_treaty_gui_send"
    enabled = "[GetScriptedGui('tca_treaty_gui_send').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_send').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
}
  expand = { layoutpolicy_vertical = expanding }
  hbox = { spacing = 12
button_standard = { size = { 200 40 } text = "tca_treaty_gui_break_arm"
    enabled = "[GetScriptedGui('tca_treaty_gui_break_arm').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_break_arm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_existing').IsSet]"
}
button_standard = { size = { 240 40 } text = "tca_treaty_gui_break"
    enabled = "[GetScriptedGui('tca_treaty_gui_break').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('tca_treaty_gui_break').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).End)]"
    visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_break_confirm').IsSet]"
}
  }
  text_multi = { text = "tca_treaty_gui_break_warning" max_width = 590 visible = "[GetPlayer.MakeScope.Var('tca_treaty_gui_break_confirm').IsSet]" }
  } }
  }
 }
}
types tca_treaty_types {
 type tca_treaty_diplomacy_row = button_standard {
  layoutpolicy_horizontal = expanding
  size = { 210 76 }
  enabled = "[GetPlayer.IsValid]"
  onclick = "[GetScriptedGui('tca_treaty_gui_open_record').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_treaty_local_player', GetPlayer.MakeScope).AddScope('tca_treaty_row_a', Scope.Var('tca_treaty_a').Char.MakeScope).AddScope('tca_treaty_row_b', Scope.Var('tca_treaty_b').Char.MakeScope).AddScope('tca_treaty_viewed', CharacterWindow.GetCharacter.MakeScope).End)]"
  vbox = {
   parentanchor = center
   text_single = { text = "tca_treaty_gui_row_b" max_width = 195 visible = "[GetScriptedGui('tca_treaty_gui_row_a').IsShown(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).AddScope('tca_treaty_row_a', Scope.Var('tca_treaty_a').Char.MakeScope).End)]" }
   text_single = { text = "tca_treaty_gui_row_a" max_width = 195 visible = "[Not(GetScriptedGui('tca_treaty_gui_row_a').IsShown(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).AddScope('tca_treaty_row_a', Scope.Var('tca_treaty_a').Char.MakeScope).End))]" }
   text_single = { text = "tca_treaty_gui_row_amount" using = Font_Size_Small }
   text_single = { text = "tca_treaty_gui_row_overdue" using = Font_Size_Small visible = "[GreaterThan_CFixedPoint(Scope.Var('tca_treaty_arrears').GetValue, '(CFixedPoint)0')]" }
  }
 }
 type tca_treaty_diplomacy_list = vbox {
  layoutpolicy_horizontal = expanding
  spacing = 4
  visible = "[GreaterThan_int32(GetDataModelSize(CharacterWindow.GetCharacter.MakeScope.GetList('tca_treaties')), '(int32)0')]"
  text_single = { text = "tca_treaty_gui_title" }
  vbox = {
   layoutpolicy_horizontal = expanding
   datamodel = "[CharacterWindow.GetCharacter.MakeScope.GetList('tca_treaties')]"
   item = { tca_treaty_diplomacy_row = {} }
  }
 }
}
