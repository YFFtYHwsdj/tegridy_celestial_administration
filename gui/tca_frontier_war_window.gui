# 最小自有宣战窗口；仅debug及本人预览状态可见，不覆盖原版窗口。
# 使用原生GetPlayer上下文和ScriptedGui桥接；不靠控制台执行正式按钮行为。
window = {
    name = "tca_frontier_war_window"
    size = { 640 510 }
    parentanchor = center
    layer = windows_layer
    visible_at_creation = no
    datacontext = "[GetPlayer]"
    visible = "[And(InDebugMode, GreaterThan_CFixedPoint(Character.MakeScope.Var('tca_frontier_window_open').GetValue, '(CFixedPoint)0'))]"
    using = Window_Background
    using = Window_Decoration
    vbox = {
        margin = { 20 20 }
        spacing = 18
        layoutpolicy_horizontal = expanding
        text_single = { text = "tca_frontier_window_title" using = Font_Size_Header }
        text_single = { text = "tca_frontier_window_attacker" }
        text_single = { text = "tca_frontier_window_defender" }
        text_single = { text = "tca_frontier_window_type" }
        text_single = { text = "tca_frontier_window_choose" }
        button_standard = {
            layoutpolicy_horizontal = expanding
            text = "[Character.MakeScope.Var('tca_frontier_window_goal_1').Title.GetName]"
            onclick = "[GetScriptedGui('tca_frontier_window_select_1_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_frontier_local_player', GetPlayer.MakeScope).End)]"
            down = "[ObjectsEqual(Character.MakeScope.Var('tca_frontier_window_goal').Title.Self, Character.MakeScope.Var('tca_frontier_window_goal_1').Title.Self)]"
        }
        button_standard = {
            layoutpolicy_horizontal = expanding
            text = "[Character.MakeScope.Var('tca_frontier_window_goal_2').Title.GetName]"
            onclick = "[GetScriptedGui('tca_frontier_window_select_2_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_frontier_local_player', GetPlayer.MakeScope).End)]"
            down = "[ObjectsEqual(Character.MakeScope.Var('tca_frontier_window_goal').Title.Self, Character.MakeScope.Var('tca_frontier_window_goal_2').Title.Self)]"
        }
        text_multi = { text = "tca_frontier_window_notice" maximumsize = { 590 -1 } autoresize = yes }
        hbox = {
            spacing = 30
            button_standard = {
                text = "tca_frontier_window_cancel"
                onclick = "[GetScriptedGui('tca_frontier_window_cancel_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_frontier_local_player', GetPlayer.MakeScope).End)]"
            }
            button_standard = {
                text = "tca_frontier_window_confirm"
                onclick = "[GetScriptedGui('tca_frontier_window_confirm_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_frontier_local_player', GetPlayer.MakeScope).End)]"
                enabled = "[GetScriptedGui('tca_frontier_window_confirm_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tca_frontier_local_player', GetPlayer.MakeScope).End)]"
            }
        }
    }
}
