  on_start = "[ExecuteConsoleCommand('effect title:h_china = { if = { limit = { var:tca_cli_human_phase = 1 } set_variable = { name = tca_cli_human_phase value = 2 } } }')]"
  # 让阶段2进入原生快照；等待本身不证明存档成功，运行器另核对保存完成日志和文件。
  duration = 6 next = tca_cli_court_human_save
 }
 state = {
  name = tca_cli_court_human_save
  on_start = "[ExecuteConsoleCommand(Select_CString(And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_court_human_saved', 'yes'))), 'save tca_cli_court_human_session', ''))]"
  on_start = "[GetVariableSystem.Set('tca_cli_court_human_saved', 'yes')]"
  duration = 8 next = tca_cli_court_human_request
 }
