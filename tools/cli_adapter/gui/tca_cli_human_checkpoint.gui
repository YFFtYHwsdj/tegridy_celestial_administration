  # 请求另有UI防重复；存档只保存脚本阶段，不保存本进程的started/requested。
  on_start = "[ExecuteConsoleCommand(Select_CString(And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_court_human_requested', 'yes'))), 'effect title:h_china = { if = { limit = { var:tca_cli_human_phase = 2 } set_variable = { name = tca_cli_ready value = 0 } debug_log = \"TCA_CLI HUMAN_SAVE tca_cli_court_human_session\" } }', ''))]"
  on_start = "[GetVariableSystem.Set('tca_cli_court_human_requested', 'yes')]"
 }
}

# 保存重启后的fresh-UI分别接入同一原生身份核验入口。
widget = {
 name = "tca_cli_court_human_load_boot"
 size = { 1 1 } alwaystransparent = yes alpha = 0 visible_at_creation = no
 datacontext = "[GetTitleByKey('h_china')]"
 visible = "[And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_case').GetValue, '(CFixedPoint)2'), And(InDebugMode, And(IsInGame, And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_court_human_started', 'yes'))))))]"
 state = { name = _show duration = 2 next = tca_cli_court_human_native_boot }
 state = {
  name = tca_cli_court_human_native_boot
  # UI重建仍只执行一次；直接event命令显式指定当前皇帝ID，避免effect内trigger_event被接受却不投递。
  on_start = "[ExecuteConsoleCommand(Select_CString(And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_court_human_booted', 'yes'))), Concatenate('event tca_cli.2 ', UIntToString(Title.GetHolder.GetID)), ''))]"
  on_start = "[GetVariableSystem.Set('tca_cli_court_human_booted', 'yes')]"
 }
}

widget = {
 name = "tca_cli_human_load_boot"
 size = { 1 1 } alwaystransparent = yes alpha = 0 visible_at_creation = no
 datacontext = "[GetTitleByKey('h_china')]"
 visible = "[And(Not(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_case').GetValue, '(CFixedPoint)2')), And(InDebugMode, And(IsInGame, And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_human_started', 'yes'))))))]"
 state = { name = _show duration = 2 next = tca_cli_human_native_boot }
 state = {
  name = tca_cli_human_native_boot
  # UI重建仍只执行一次；直接event命令显式指定当前皇帝ID，避免effect内trigger_event被接受却不投递。
  on_start = "[ExecuteConsoleCommand(Select_CString(And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)2'), Not(GetVariableSystem.HasValue('tca_cli_human_booted', 'yes'))), Concatenate('event tca_cli.2 ', UIntToString(Title.GetHolder.GetID)), ''))]"
  on_start = "[GetVariableSystem.Set('tca_cli_human_booted', 'yes')]"
 }
}

# 原生身份核验只授权，业务入口再由独立界面动作直接event；不从事件回调同步内投。
# 每个人类进程只执行一个业务用例；UI防重与业务入口持久防重共同避免重复BEGIN。
widget = {
 name = "tca_cli_human_business_dispatch"
 size = { 1 1 } alwaystransparent = yes alpha = 0 visible_at_creation = no
 datacontext = "[GetTitleByKey('h_china')]"
 visible = "[And(InDebugMode, And(IsInGame, And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_phase').GetValue, '(CFixedPoint)3'), Or(And(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_case').GetValue, '(CFixedPoint)2'), EqualTo_CFixedPoint(Title.MakeScope.Var('tca_court_human_run').GetValue, '(CFixedPoint)1')), And(Not(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_case').GetValue, '(CFixedPoint)2')), EqualTo_CFixedPoint(Title.MakeScope.Var('tca_retirement_human_run').GetValue, '(CFixedPoint)1'))))))]"
 state = {
  name = _show
  on_start = "[ExecuteConsoleCommand(Select_CString(Not(GetVariableSystem.HasValue('tca_cli_human_business_dispatched', 'yes')), Concatenate(Select_CString(EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_human_case').GetValue, '(CFixedPoint)2'), 'event tca_court_session.1 ', 'event tca_retirement_session.1 '), UIntToString(Title.GetHolder.GetID)), ''))]"
  on_start = "[GetVariableSystem.Set('tca_cli_human_business_dispatched', 'yes')]"
 }
}
