widget = {
 name = "tca_cli_observe"
 size = { 1 1 }
 alwaystransparent = yes
 alpha = 0
 visible_at_creation = no
 datacontext = "[GetTitleByKey('h_china')]"
 visible = "[And(IsInGame, EqualTo_CFixedPoint(Title.MakeScope.Var('tca_cli_ready').GetValue, '(CFixedPoint)1'))]"
 state = {
  name = _show
  on_start = "[ExecuteConsoleCommand('observe')]"
  on_start = "[SetGameSpeed('(int32)4')]"
 }
}
widget = {
 name = "tca_cli_unpause"
 size = { 1 1 }
 alwaystransparent = yes
 alpha = 0
 visible_at_creation = no
 datacontext = "[GetTitleByKey('h_china')]"
 visible = "[And(IsInGame, And(IsManuallyPaused, GreaterThan_CFixedPoint(Title.MakeScope.Var('tca_cli_ready').GetValue, '(CFixedPoint)0')))]"
 state = { name = _show on_start = "[OnPause]" }
}
